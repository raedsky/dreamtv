<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="315" android:startColor="#FFFF512F" android:endColor="#FFDD2476" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" /><corners android:radius="22dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="315" android:startColor="#FFDD2476" android:endColor="#FFFF512F" /><corners android:radius="22dp" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="315" android:startColor="#FFFF512F" android:endColor="#FFDD2476" /><corners android:radius="22dp" /></shape>
    </item>
</selector>
