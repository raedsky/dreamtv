<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#1AFFFFFF" />
            <stroke android:width="3dp" android:color="#FF8B5CF6" /><corners android:radius="24dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#2EFFFFFF" /><stroke android:width="2dp" android:color="#FF8B5CF6" /><corners android:radius="24dp" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
</selector>
