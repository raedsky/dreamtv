<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <com.mytv.player.ui.StreaksView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0.55" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- القوائم -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7"
            android:orientation="vertical"
            android:paddingStart="40dp" android:paddingTop="20dp" android:paddingEnd="30dp" android:paddingBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="64dp" android:layout_height="52dp"
                    android:clickable="true" android:focusable="false"
                    android:scaleType="fitCenter" android:src="@drawable/ic_launcher" />
                <View
                    android:layout_width="2dp" android:layout_height="32dp"
                    android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                    android:background="#CCFFFFFF" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/playlist_title"
                    android:textColor="@color/text_primary" android:textSize="24sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylists"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="18dp"
                android:clipToPadding="false" android:padding="4dp"
                android:scrollbars="none" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/welcome"
                android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center"
                android:text="@string/enjoy_streaming"
                android:textColor="@color/text_secondary" android:textSize="15sp" />
        </LinearLayout>

        <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#E6FFFFFF" />

        <!-- معلومات الجهاز -->
        <FrameLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3.2">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical" android:padding="24dp">
                <ImageView
                    android:layout_width="200dp" android:layout_height="150dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_launcher" />
                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/mac_label"
                    android:textColor="@color/text_primary" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvMac"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:tag="accent"
                    android:textSize="24sp" />
                <TextView
                    android:id="@+id/tvExpiryLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/device_status"
                    android:textColor="@color/text_primary" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:tag="accent"
                    android:textSize="20sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="16dp"
                android:textColor="@color/text_primary" android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
