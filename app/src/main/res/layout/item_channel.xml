<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="52dp"
    android:layout_marginBottom="3dp"
    android:tag="cell" android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="14dp" android:paddingEnd="14dp">
    <TextView
        android:id="@+id/tvNum"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:tag="celltext" android:textSize="15sp" />
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="34dp" android:layout_height="26dp"
        android:layout_marginStart="10dp"
        android:scaleType="fitCenter" />
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end" android:maxLines="1"
        android:tag="celltext" android:textSize="16sp" />
    <TextView
        android:id="@+id/tvFav"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:text="♥"
        android:textColor="#FFFF4D6D" android:textSize="16sp" android:visibility="gone" />
</LinearLayout>
