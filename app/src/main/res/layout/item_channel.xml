<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_item" android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="56dp" android:layout_height="40dp"
        android:scaleType="fitCenter" />
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end" android:maxLines="2"
        android:textColor="@color/text_primary" android:textSize="15sp" />
    <TextView
        android:id="@+id/tvFav"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:text="★"
        android:textColor="@color/accent" android:textSize="18sp" android:visibility="gone" />
</LinearLayout>
