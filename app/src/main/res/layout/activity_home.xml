<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:paddingStart="32dp" android:paddingTop="20dp" android:paddingEnd="32dp" android:paddingBottom="16dp">

    <!-- الشريط العلوي: الشعار + الوقت والتاريخ -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_launcher" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/app_name" android:textColor="@color/text_primary"
            android:textSize="26sp" android:textStyle="bold" />
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="end" android:orientation="vertical">
            <TextClock
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="hh:mm a" android:format24Hour="HH:mm"
                android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
            <TextClock
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="EEEE, d MMM yyyy" android:format24Hour="EEEE, d MMM yyyy"
                android:textColor="@color/text_secondary" android:textSize="14sp" />
            <TextView
                android:id="@+id/tvWeather"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/accent" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- البطاقات الكبيرة -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="20dp" android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tileLive"
            style="@style/HomeTile"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25"
            android:background="@drawable/bg_tile_live">
            <ImageView style="@style/HomeTileIcon" android:layout_width="96dp" android:layout_height="96dp"
                android:src="@drawable/ic_live" />
            <TextView style="@style/HomeTileText" android:textSize="30sp" android:text="@string/live" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/tileMovies"
                style="@style/HomeTile"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:background="@drawable/bg_tile_movies">
                <ImageView style="@style/HomeTileIcon" android:src="@drawable/ic_movie" />
                <TextView style="@style/HomeTileText" android:text="@string/movies" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tileSeries"
                style="@style/HomeTile"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:background="@drawable/bg_tile_series">
                <ImageView style="@style/HomeTileIcon" android:src="@drawable/ic_series" />
                <TextView style="@style/HomeTileText" android:text="@string/series" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- الأزرار الصغيرة -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/btnPlaylists" style="@style/HomeSmallBtn">
            <ImageView style="@style/HomeSmallIcon" android:src="@drawable/ic_account" />
            <TextView style="@style/HomeSmallText" android:text="@string/playlists" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnReload" style="@style/HomeSmallBtn">
            <ImageView style="@style/HomeSmallIcon" android:src="@drawable/ic_reload" />
            <TextView style="@style/HomeSmallText" android:text="@string/reload" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnSettings" style="@style/HomeSmallBtn">
            <ImageView style="@style/HomeSmallIcon" android:src="@drawable/ic_settings" />
            <TextView style="@style/HomeSmallText" android:text="@string/settings" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnExit" style="@style/HomeSmallBtn">
            <ImageView style="@style/HomeSmallIcon" android:src="@drawable/ic_exit" />
            <TextView style="@style/HomeSmallText" android:text="@string/exit" />
        </LinearLayout>
    </LinearLayout>

    <!-- معلومات الاشتراك -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView
            android:id="@+id/tvAccount"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text_primary" android:textSize="15sp" />
        <TextView
            android:id="@+id/tvExpiry"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/accent" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
