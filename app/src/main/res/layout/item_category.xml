<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="52dp"
    android:layout_marginBottom="3dp"
    android:tag="cell" android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="18dp" android:paddingEnd="18dp">
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:ellipsize="end" android:maxLines="1"
        android:tag="celltext" android:textSize="16sp" />
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:tag="celltext" android:textSize="16sp" />
</LinearLayout>
